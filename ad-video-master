#!/usr/bin/env python3
"""ad-video-master - two-pass loudnorm master for a finished ad video.

    ad-video-master IN.mp4 OUT.mp4 [--target -14] [--tp -1.5]

PASS needs -16..-12 LUFS and TP <= -1.0 dBTP on the FINAL mp4 (AAC
encoding moves the true peak). Exit: 0 pass, 1 fail, 2 usage.
"""
import json, re, subprocess, sys


def ff(*a):
    return subprocess.run(["ffmpeg", "-hide_banner", "-nostats", *a],
                          capture_output=True, text=True)


def measure(path):
    p = ff("-i", path, "-af", "loudnorm=I=-14:TP=-1.5:LRA=11:print_format=json",
           "-vn", "-f", "null", "-")
    m = re.search(r"\{.*\}", p.stderr, re.S)
    try:
        d = json.loads(m.group(0))
        return float(d["input_i"]), float(d["input_tp"]), d
    except (AttributeError, ValueError, KeyError, TypeError):
        return None


def main():
    a = sys.argv[1:]
    tgt = a[a.index("--target") + 1] if "--target" in a else "-14"
    tps = a[a.index("--tp") + 1] if "--tp" in a else "-1.5"
    skip = {"--target", "--tp"}
    pos = [x for i, x in enumerate(a)
           if not x.startswith("-") and (i == 0 or a[i - 1] not in skip)]
    if len(pos) != 2:
        print("usage: ad-video-master IN.mp4 OUT.mp4 [--target -14] [--tp -1.5]",
              file=sys.stderr)
        return 2
    src, dst = pos
    before = measure(src)
    if before is None:
        print("FAIL: cannot measure input (no audio or bad file)")
        return 1
    d = before[2]
    af = (f"loudnorm=I={tgt}:TP={tps}:LRA=11:measured_I={d['input_i']}:"
          f"measured_TP={d['input_tp']}:measured_LRA={d['input_lra']}:"
          f"measured_thresh={d['input_thresh']}:offset={d['target_offset']}:"
          "linear=true,alimiter=limit=0.841:level=disabled")
    p = ff("-y", "-i", src, "-map", "0:v", "-map", "0:a", "-c:v", "copy",
           "-af", af, "-c:a", "aac", "-b:a", "192k", dst)
    if p.returncode != 0:
        print("FAIL: pass-2 encode failed: " + p.stderr[-300:])
        return 1
    after = measure(dst)
    if after is None:
        print("FAIL: cannot measure output")
        return 1
    print(f"before: {before[0]:.1f} LUFS, {before[1]:.1f} dBTP | "
          f"after: {after[0]:.1f} LUFS, {after[1]:.1f} dBTP")
    if not (-16.0 <= after[0] <= -12.0 and after[1] <= -1.0):
        print("FAIL: need -16..-12 LUFS and TP <= -1.0 dBTP")
        return 1
    print("PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
