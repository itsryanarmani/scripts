#!/usr/bin/env python3
"""ad-event-switch: move Meta ad sets to a new conversion event by copying them. Dry run by default.
Meta refuses to edit the event of a published ad set, so each ad set is copied. See ad-event-switch.md."""
import argparse, json, math, os, re, sys, time
import urllib.error, urllib.parse, urllib.request
RATE_LIMIT = (17, 2446079)  # ads-management "user request limit reached"; nothing else is retried
WAITS = (60, 120, 240)
FIELDS = ("id,name,effective_status,campaign_id,lifetime_budget,budget_remaining,daily_budget,end_time,billing_event,"
          "optimization_goal,bid_strategy,bid_amount,adset_schedule,frequency_control_specs,targeting,promoted_object,destination_type,"
          "attribution_spec,pacing_type")
SECRETS = []
def scrub(s):
    s = re.sub(r"(access_token=)[^&\s\"']+", r"\1<redacted>", str(s))
    for v in SECRETS:
        s = s.replace(v, "<redacted>")
    return s
say = lambda *parts: print(scrub(" ".join(str(p) for p in parts)), flush=True)
def load_env(path):
    pairs = (l.strip().split("=", 1) for l in open(path) if "=" in l and not l.strip().startswith("#"))
    return {k.strip(): v.strip().strip("\"'") for k, v in pairs}
class Graph:
    def __init__(self, token, version):
        self.token = token
        self.base = os.environ.get("AD_EVENT_SWITCH_GRAPH_URL", "https://graph.facebook.com").rstrip("/") + "/" + version
        self.scale = float(os.environ.get("AD_EVENT_SWITCH_SLEEP_SCALE", "1"))  # tests set 0
    def call(self, method, path, params=None):
        for attempt in range(len(WAITS) + 1):
            status, body = self._once(method, path, params)
            err = body.get("error") or {}
            if (err.get("code"), err.get("subcode")) != RATE_LIMIT or attempt == len(WAITS):
                return status, body
            say(f"   rate limited (code 17 / 2446079) on {method} {path.split('/')[-1]}; retry {attempt + 1}/{len(WAITS)} in {WAITS[attempt]}s")
            time.sleep(WAITS[attempt] * self.scale)
    def _once(self, method, path, params):
        enc = urllib.parse.urlencode({k: v if isinstance(v, str) else json.dumps(v) for k, v in (params or {}).items()})
        url = f"{self.base}/{path}" + (f"?{enc}" if method == "GET" else "")
        # The token goes in a header, never in the URL, so a logged URL cannot leak it.
        req = urllib.request.Request(url, data=None if method == "GET" else enc.encode(), method=method,
                                     headers={"Authorization": f"Bearer {self.token}"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.status, json.loads(r.read())
        except urllib.error.HTTPError as e:
            raw = e.read()
            err = json.loads(raw).get("error", {}) if raw.strip().startswith(b"{") else {}
            return e.code, {"error": {"code": err.get("code"), "subcode": err.get("error_subcode"), "message": scrub(err.get("error_user_msg") or err.get("message", ""))}}
        except (urllib.error.URLError, TimeoutError, ValueError) as e:  # network failure or a non-JSON reply
            return 0, {"error": {"code": None, "subcode": None, "message": scrub(f"no usable reply: {e}")}}
class Stop(Exception):
    """A write failed. The message lists what exists."""
class Skip(Exception):
    """One ad set needs more budget than --max-extra-cents allows. Nothing was created for it."""
def need(graph, method, path, params, made):
    status, body = graph.call(method, path, params)
    if "error" in body:
        e = body["error"]
        raise Stop(f"{method} {path} failed (code {e.get('code')}): {e.get('message')}. Already created: {', '.join(made) or 'nothing'}")
    return body
def plan_budget(old):
    """The copy gets the daily budget, or the lifetime budget that remains."""
    if int(old.get("daily_budget") or 0) > 0:
        return "daily_budget", str(old["daily_budget"])
    return "lifetime_budget", str(old["budget_remaining"])
def unsupported(old):
    """Why this tool cannot copy the ad set faithfully, or None. The copy would differ, so the tool leaves it alone."""
    if old.get("bid_strategy", "LOWEST_COST_WITHOUT_CAP") != "LOWEST_COST_WITHOUT_CAP" or old.get("bid_amount"):
        return "it has a bid cap or cost cap"
    if old.get("adset_schedule") or old.get("frequency_control_specs"):
        return "it has dayparting or a frequency cap"
    return None
def copy_one(graph, acct, old, args, made):
    name = f"{old['name']} [{args.to_event}]"
    key, amount = plan_budget(old)
    # Read the ads first. An ad set with no ACTIVE ad must not become an empty copy that replaces it.
    ads = [a for a in need(graph, "GET", f"{old['id']}/ads", {"fields": "id,name,effective_status,creative{id}", "limit": "50"}, made)["data"]
           if a["effective_status"] == "ACTIVE"]
    if not ads:
        raise Skip(f"{old['name']}: no ACTIVE ad to copy. Nothing created for it.")
    po = {**old["promoted_object"], "custom_event_type": args.to_event}
    body = {"name": name, "campaign_id": old["campaign_id"], "status": "PAUSED", key: amount, "end_time": old.get("end_time"),
            "billing_event": old["billing_event"], "optimization_goal": old["optimization_goal"], "bid_strategy": old.get("bid_strategy"),
            "targeting": old["targeting"], "promoted_object": po, "destination_type": old.get("destination_type"),
            "attribution_spec": old.get("attribution_spec"), "pacing_type": old.get("pacing_type"), "is_dynamic_creative": "false"}
    body = {k: v for k, v in body.items() if v is not None}  # Graph leaves out fields that have no value
    status, res = graph.call("POST", f"act_{acct}/adsets", body)
    floor = re.search(r"more than [A-Z$]*?(\d+(?:\.\d+)?)", (res.get("error") or {}).get("message", ""))
    if "error" in res and floor and math.ceil((float(floor.group(1)) + 0.01) * 100) > int(amount):  # Meta states the least it accepts
        raised = math.ceil((float(floor.group(1)) + 0.01) * 100)
        extra = raised - int(amount)
        if extra > args.max_extra_cents:
            raise Skip(f"{old['name']}: Meta needs {raised} cents and only {amount} remain: {extra} extra cents is over --max-extra-cents {args.max_extra_cents}. Nothing created for it.")
        say(f"   {old['name']}: budget raised from {amount} to {raised} cents (+{extra}) to meet Meta's minimum")
        status, res = graph.call("POST", f"act_{acct}/adsets", {**body, key: str(raised)})
    if "error" in res:
        e = res["error"]
        raise Stop(f"POST adsets failed (code {e.get('code')}): {e.get('message')}. Already created: {', '.join(made) or 'nothing'}")
    new_id = res["id"]
    made.append(f"adset {new_id}")
    new_ads = []
    for ad in ads:
        r = need(graph, "POST", f"act_{acct}/ads", {"name": ad["name"], "adset_id": new_id, "creative": {"creative_id": ad["creative"]["id"]}, "status": "PAUSED"}, made)
        made.append(f"ad {r['id']}")
        new_ads.append(r["id"])
    if args.activate:
        for i in new_ads:
            need(graph, "POST", i, {"status": "ACTIVE"}, made)
        need(graph, "POST", new_id, {"status": "ACTIVE"}, made)
        try:
            need(graph, "POST", old["id"], {"status": "PAUSED"}, made)
        except Stop as e:
            raise Stop(f"BOTH ARE LIVE: copy {new_id} is ACTIVE and the original {old['id']} still runs, so spend can double. "
                       f"Pause {old['id']} now. Cause: {e}")
    return new_id, len(new_ads)
def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--ad-account-id"), ap.add_argument("--env-file"), ap.add_argument("--api-version", default="v21.0")
    ap.add_argument("--from-event", required=True), ap.add_argument("--to-event", required=True)
    ap.add_argument("--adset", action="append", default=[], help="limit to this ad set id; repeat for more")
    ap.add_argument("--execute", action="store_true", help="create PAUSED copies")
    ap.add_argument("--activate", action="store_true", help="with --execute: activate each copy and its ads, then pause the original")
    ap.add_argument("--max-extra-cents", type=int, default=200)
    args = ap.parse_args()
    env = load_env(args.env_file or os.environ.get("AD_EVENT_SWITCH_ENV_FILE", "")) if (args.env_file or os.environ.get("AD_EVENT_SWITCH_ENV_FILE")) else {}
    token = env.get("META_MARKETING_TOKEN") or os.environ.get("META_MARKETING_TOKEN")
    acct = (args.ad_account_id or os.environ.get("META_AD_ACCOUNT_ID") or "").removeprefix("act_")
    if not token or not acct:
        say("refused: set META_MARKETING_TOKEN (in --env-file) and --ad-account-id"); return 2
    if args.activate and not args.execute:
        say("refused: --activate needs --execute"); return 2
    SECRETS.append(token)
    graph = Graph(token, args.api_version)
    sets, after = [], None
    while True:  # follow the cursor, never paging.next: that URL carries the token
        params = {"fields": FIELDS, "limit": "100", **({"after": after} if after else {})}
        status, listing = graph.call("GET", f"act_{acct}/adsets", params)
        if "error" in listing:
            say("listing failed:", listing["error"].get("message")); return 3
        sets += listing["data"]
        after = ((listing.get("paging") or {}).get("cursors") or {}).get("after") if (listing.get("paging") or {}).get("next") else None
        if not after:
            break
    have = {s["name"] for s in sets}
    todo = [s for s in sets if s.get("effective_status") == "ACTIVE" and (s.get("promoted_object") or {}).get("custom_event_type") == args.from_event
            and (not args.adset or s["id"] in args.adset)]
    for s in [s for s in todo if unsupported(s)]:
        say(f" skip {s['id']} {s['name']}: {unsupported(s)}, which the copy would not keep"); todo.remove(s)
    say(f"{len(todo)} active ad set(s) optimize for {args.from_event}; target {args.to_event}" + ("" if args.execute else " (dry run)"))
    made, skipped, refused = [], 0, 0
    try:
        for s in todo:
            key, amount = plan_budget(s)
            copy_name = f"{s['name']} [{args.to_event}]"
            if copy_name in have:
                say(f" skip {s['id']} {s['name']}: the copy exists"); skipped += 1; continue
            if not args.execute:
                say(f" would copy {s['id']} {s['name']}: {key} {amount}"); continue
            try:
                new_id, n = copy_one(graph, acct, s, args, made)
            except Skip as e:
                say(" refused:", e); refused += 1; continue
            say(f" copied {s['id']} -> {new_id} with {n} ad(s), {'ACTIVE; original paused' if args.activate else 'PAUSED'}")
    except Stop as e:
        say("stopped:", e)
        say("created so far:", ", ".join(made) or "nothing")
        return 3
    say(f"done: {len(made)} object(s) created, {skipped} skipped, {refused} refused")
    return 2 if refused else 0
if __name__ == "__main__":
    sys.exit(main())
