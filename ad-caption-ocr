#!/usr/bin/env python3
"""ad-caption-ocr VIDEO.mp4 CAPTIONS.json - Vision OCR check (macOS).

CAPTIONS.json: a list, or {"groups"|"captions": [...]}, of
{"start","end","text"}. One frame per caption midpoint is sampled;
macOS Vision OCR reads it. The Swift helper is compiled with
`swiftc -O` (never `swift file.swift` — the interpreter hangs),
retried once on a Vision e5rt crash. CER = edit distance / expected
length, upper case, punctuation/emoji/spaces collapsed; FAIL above
0.10. Exit: 0 pass, 1 fail, 2 usage/environment.
"""
import atexit, json, os, shutil, subprocess, sys, tempfile

SWIFT = r'''
import Foundation
import Vision
import ImageIO
struct E: Decodable { let image: String; let expected: String }
func norm(_ s: String) -> String {
    s.uppercased().map { $0.isLetter || $0.isNumber ? $0 : " " }
     .reduce(into: "") { $0.append($1) }.split(separator: " ").joined(separator: " ")
}
func lev(_ a: String, _ b: String) -> Int {
    guard !a.isEmpty, !b.isEmpty else { return a.isEmpty ? b.count : a.count }
    let aa = Array(a), bb = Array(b)
    var prev = Array(0...bb.count)
    for i in 1...aa.count {
        var cur = [i] + Array(repeating: 0, count: bb.count)
        for j in 1...bb.count {
            cur[j] = min(prev[j]+1, cur[j-1]+1, prev[j-1] + (aa[i-1] == bb[j-1] ? 0 : 1))
        }
        prev = cur
    }
    return prev[bb.count]
}
func ocr(_ path: String) -> String {
    guard let src = CGImageSourceCreateWithURL(URL(fileURLWithPath: path) as CFURL, nil),
          let img = CGImageSourceCreateImageAtIndex(src, 0, nil) else { return "" }
    let req = VNRecognizeTextRequest()
    req.recognitionLevel = .accurate
    req.usesLanguageCorrection = false
    req.recognitionLanguages = ["en-US"]
    try? VNImageRequestHandler(cgImage: img, options: [:]).perform([req])
    return (req.results ?? []).compactMap { $0.topCandidates(1).first?.string }
        .joined(separator: " ")
}
let args = CommandLine.arguments
let data = try Data(contentsOf: URL(fileURLWithPath: args[1]))
let entries = try JSONDecoder().decode([E].self, from: data)
var frames: [[String: Any]] = [], worst = 0.0
for e in entries {
    let got = ocr(e.image)
    let en = norm(e.expected), on = norm(got)
    let c = en.isEmpty ? (on.isEmpty ? 0.0 : 1.0) : Double(lev(on, en)) / Double(en.count)
    worst = max(worst, c)
    frames.append(["image": e.image, "expected": e.expected, "got": got,
                   "cer": (c * 1000).rounded() / 1000])
}
let out: [String: Any] = ["frames": frames, "max_cer": (worst*1000).rounded()/1000,
                           "fail": worst > 0.10]
try JSONSerialization.data(withJSONObject: out, options: [.prettyPrinted])
    .write(to: URL(fileURLWithPath: args[2]))
print("frames=\(frames.count) max_cer=\(worst) fail=\(worst > 0.10)")
'''


def main():
    if len(sys.argv) != 3 or not all(os.path.exists(a) for a in sys.argv[1:]):
        print("usage: ad-caption-ocr VIDEO.mp4 CAPTIONS.json", file=sys.stderr)
        return 2
    miss = [t for t in ("ffmpeg", "swiftc") if not shutil.which(t)]
    if miss: print("missing " + ", ".join(miss), file=sys.stderr); return 2
    try:
        d = json.load(open(sys.argv[2]))
        caps = ((d.get("groups") or d.get("captions")) if isinstance(d, dict)
                else d) or []
        caps = [(float(c["start"]), float(c["end"]), c.get("text") or
                 " ".join(c.get("words") or [])) for c in caps
                if isinstance(c, dict) and c.get("start") is not None
                and c.get("end") is not None and (c.get("text") or c.get("words"))]
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        print(f"FAIL: bad captions JSON: {e}", file=sys.stderr)
        return 2
    if not caps:
        print("FAIL: no caption entries found")
        return 1
    tmp = tempfile.mkdtemp(prefix="ad-caption-ocr-")
    atexit.register(shutil.rmtree, tmp, ignore_errors=True)
    manifest = []
    for i, (s, e, text) in enumerate(caps):
        png = os.path.join(tmp, f"f{i:03d}.png")
        t = (s + e) / 2
        p = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-ss",
                            f"{t:.3f}", "-i", sys.argv[1], "-frames:v", "1",
                            "-y", png], capture_output=True)
        if p.returncode != 0 or not os.path.exists(png):
            print(f"FAIL: no frame at {t:.2f}s for caption {i}")
            return 1
        manifest.append({"image": png, "expected": text})
    mpath = os.path.join(tmp, "manifest.json")
    json.dump(manifest, open(mpath, "w"))
    src, exe, outj = (os.path.join(tmp, n) for n in ("ocr.swift", "ocr", "out.json"))
    open(src, "w").write(SWIFT)
    c = subprocess.run(["swiftc", "-O", src, "-o", exe], capture_output=True, text=True)
    if c.returncode != 0:
        print("FAIL: swiftc failed: " + c.stderr[-300:]); return 2
    res = None
    for _ in range(2):
        r = subprocess.run([exe, mpath, outj], capture_output=True, text=True)
        if r.returncode == 0 and os.path.exists(outj):
            res = json.load(open(outj)); break
        if r.returncode == 0 or "e5rt" not in r.stderr: break
    if res is None:
        print("FAIL: OCR helper failed" + (" (Vision e5rt, retried once)"
              if "e5rt" in r.stderr else ": " + r.stderr[-300:]))
        return 1
    for f in res["frames"]:
        print(f"cer={f['cer']:.3f} expected={f['expected']!r} got={f['got']!r}")
    print(f"max_cer={res['max_cer']}")
    print("FAIL" if res["fail"] else "PASS")
    return 1 if res["fail"] else 0


if __name__ == "__main__":
    sys.exit(main())
