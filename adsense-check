#!/usr/bin/env python3
"""adsense-check: verify the two AdSense ownership proofs on a site. See adsense-check.md."""
import argparse, json, os, re, signal, sys, time, urllib.error, urllib.parse, urllib.request
from html.parser import HTMLParser

TIMEOUT = 15
DEADLINE = 30  # whole run, both fetches and every redirect hop
MAX_REDIRECTS = 3
MAX_BYTES = 2 * 1024 * 1024
CERT_ID = "f08c47fec0942fa0"


class DeadlineExceeded(Exception):
    pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def res(hops, status=None, headers=None, body=b"", error=None):
    return {"status": status, "headers": headers, "body": body, "hops": hops, "error": error}


def read_body(r, deadline):
    out = bytearray()
    read1 = getattr(r, "read1", None) or r.read
    while len(out) <= MAX_BYTES:
        left = deadline - time.monotonic()
        if left <= 0: return None
        try: r.fp.raw._sock.settimeout(min(TIMEOUT, left))
        except (AttributeError, OSError): pass
        chunk = read1(min(8192, MAX_BYTES + 1 - len(out)))
        if not chunk: break
        out += chunk
    return bytes(out[:MAX_BYTES])


def fetch(url, allowed, deadline):
    hops = []
    for _ in range(MAX_REDIRECTS + 1):
        left = deadline - time.monotonic()
        if left <= 0: return res(hops, error="deadline exceeded")
        req = urllib.request.Request(url, headers={"User-Agent": "adsense-check/1.0 (+ownership check)"})
        try:
            with OPENER.open(req, timeout=min(TIMEOUT, max(0.001, left))) as r:
                hops.append({"url": url, "status": r.status})
                body = read_body(r, deadline)
                if body is None:
                    return res(hops, status=r.status, headers=r.headers, error="deadline exceeded")
                return res(hops, status=r.status, headers=r.headers, body=body)
        except urllib.error.HTTPError as e:
            hops.append({"url": url, "status": e.code})
            if e.code not in (301, 302, 303, 307, 308):
                return res(hops, status=e.code, headers=e.headers)
            nxt = urllib.parse.urljoin(url, e.headers.get("Location", "")) if e.headers else ""
            p = urllib.parse.urlparse(nxt)
            if p.scheme not in ("http", "https") or not p.hostname:
                return res(hops, status=e.code, headers=e.headers,
                           error=f"redirect to unsupported URL: {nxt}")
            if p.hostname.lower() not in allowed:
                return res(hops, status=e.code, headers=e.headers,
                           error=f"redirect left the site domain: {nxt}")
            url = nxt
        except DeadlineExceeded as e:
            hops.append({"url": url, "status": "deadline exceeded"})
            return res(hops, error=f"deadline exceeded after {e.args[0]:.0f} s")
        except Exception as e:
            late = time.monotonic() > deadline - 0.01  # socket timeout can land a hair early
            hops.append({"url": url, "status": "deadline exceeded" if late else type(e).__name__})
            return res(hops, error="deadline exceeded" if late else f"{type(e).__name__}: {e}")
    return res(hops, error="too many redirects")


class MetaParser(HTMLParser):
    """google-adsense-account meta tags; noscript/comments/script ignored."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.head, self.outside = [], []
        self._noscript, self._in_body = 0, False

    def _meta(self, attrs):
        if not self._noscript:
            (self.outside if self._in_body else self.head).append(dict(attrs))

    def handle_starttag(self, tag, attrs):
        t = tag.lower()
        if t == "noscript": self._noscript += 1
        elif t == "body": self._in_body = True
        elif t == "meta": self._meta(attrs)
        elif not self._noscript and t not in ("html", "head", "base", "link", "title", "style", "script", "template"): self._in_body = True

    def handle_endtag(self, tag):
        t = tag.lower()
        if t == "noscript" and self._noscript: self._noscript -= 1
        elif t == "head": self._in_body = True


def meta_ids(html):
    p = MetaParser()
    try: slow = float(os.environ.get("ADSENSE_CHECK_TEST_SLOW_PARSE") or 0)
    except ValueError: slow = 0
    try:
        for i in range(0, len(html), 65536):
            p.feed(html[i:i + 65536])
            if 0 < slow < 60: time.sleep(slow)
    except DeadlineExceeded: raise
    except Exception: pass
    pick = lambda tags: [t.get("content", "") for t in tags
                         if t.get("name", "").lower() == "google-adsense-account"]
    return pick(p.head), pick(p.outside)


def ads_txt_problems(status, ctype, body, digits):
    problems = []
    if status != 200: problems.append(f"status {status}, want 200")
    if not (ctype or "").lower().startswith("text/plain"):
        problems.append(f"content-type {ctype or 'missing'}, want text/plain")
    text = body.decode("utf-8-sig", "replace")
    if "<html" in text.lower():
        problems.append("body contains HTML (a soft 404 page returns 200)")
    want = f"google.com, pub-{digits}, DIRECT, {CERT_ID}"
    found = False
    for line in text.splitlines():
        p = [x.strip() for x in line.split("#", 1)[0].split(",")]
        if len(p) == 4 and p[0].lower() == "google.com" and p[1] == f"pub-{digits}" \
                and p[2].upper() == "DIRECT" and p[3] == CERT_ID:
            found = True
            break
    if not found: problems.append(f"no line '{want}'")
    return problems


def main():
    ap = argparse.ArgumentParser(
        description="Verify AdSense ownership proofs: ads.txt line and google-adsense-account meta tag.")
    ap.add_argument("domain", help="site domain, e.g. example.com")
    ap.add_argument("publisher_id", help="ca-pub-<16 digits> or pub-<16 digits>")
    ap.add_argument("--json", action="store_true", help="print one JSON object")
    args = ap.parse_args()
    for v in ("ADSENSE_CHECK_TEST_BASE_URL", "ADSENSE_CHECK_TEST_DEADLINE", "ADSENSE_CHECK_TEST_NO_WATCHDOG", "ADSENSE_CHECK_TEST_SLOW_PARSE"):
        if os.environ.get(v): print(f"adsense-check: test override active: {v}", file=sys.stderr)

    m = re.match(r"^(?:ca-pub-|pub-)([0-9]{16})$", (args.publisher_id or "").strip())
    if not m: print(f"adsense-check: bad publisher id {args.publisher_id!r}; want ca-pub-<16 digits> or pub-<16 digits>", file=sys.stderr); return 2
    pub = "ca-pub-" + m.group(1)
    digits = m.group(1)

    domain = re.sub(r"^https?://", "", args.domain.strip().lower()).split("/")[0].split(":")[0]
    base = os.environ.get("ADSENSE_CHECK_TEST_BASE_URL", "").rstrip("/")
    site_host = (urllib.parse.urlparse(base).hostname or "").lower() if base else domain
    apex = site_host[4:] if site_host.startswith("www.") else site_host
    allowed = {site_host, apex, "www." + apex}  # host pair only; no suffix guessing
    urls = {"ads.txt": f"{base}/ads.txt" if base else f"https://{domain}/ads.txt", "home": f"{base}/" if base else f"https://{domain}/"}
    try: budget = float(os.environ.get("ADSENSE_CHECK_TEST_DEADLINE") or DEADLINE)
    except ValueError: budget = DEADLINE
    if not 0 < budget < float("inf"): budget = DEADLINE
    deadline = time.monotonic() + budget

    checks, results, ok = [], {}, True

    def record(name, result, reason):
        nonlocal ok
        ok = ok and result != "fail"
        checks.append({"check": name, "result": result, "reason": reason})
        if not args.json:
            tag = {"fail": "FAIL", "pass": "PASS", "info": "INFO"}[result]
            print(f"{tag} {name}: {reason}" if reason else f"{tag} {name}")

    watchdog = hasattr(signal, "setitimer") and not os.environ.get("ADSENSE_CHECK_TEST_NO_WATCHDOG")
    if watchdog:
        def _al(s, f): raise DeadlineExceeded(budget)
        prev = signal.signal(signal.SIGALRM, _al); signal.setitimer(signal.ITIMER_REAL, budget)
    try:
        bodies = {}
        for key, url in urls.items():
            r = fetch(url, allowed, deadline)
            bodies[key] = r
            results[key] = {"url": url, "status": r["status"], "hops": r["hops"],
                            **({"error": r["error"]} if r["error"] else {})}
            if not args.json:
                hops = " -> ".join(str(h["status"]) for h in r["hops"])
                print(f"INFO fetch {key}: {url} [{hops}]")

        # ads.txt: status, content type, publisher line, no HTML.
        at = bodies["ads.txt"]
        if at["error"] or at["status"] != 200:
            record("ads.txt", "fail", at["error"] or f"status {at['status']}, want 200")
        else:
            ctype = at["headers"].get("Content-Type", "") if at["headers"] else ""
            probs = ads_txt_problems(at["status"], ctype, at["body"], digits)
            record("ads.txt", "fail" if probs else "pass",
                   "; ".join(probs) if probs else
                   f"status 200, text/plain, google.com DIRECT line for pub-{digits}")

        # meta tag on the home page: exactly one in <head>, value equals the publisher id.
        hm = bodies["home"]
        if hm["error"] or hm["status"] != 200:
            record("meta tag", "fail", hm["error"] or f"home page status {hm['status']}, want 200")
        else:
            page = hm["body"].decode("utf-8-sig", "replace")
            head_ids, outside_ids = meta_ids(page)
            if outside_ids:
                record("meta tag position", "info", "meta tag found outside head")
            ids = head_ids
            if not ids:
                record("meta tag", "fail", "meta tag found outside head" if outside_ids
                       else "no google-adsense-account meta tag on the home page")
            elif len(ids) > 1:
                record("meta tag", "fail", f"{len(ids)} google-adsense-account meta tags in head, want 1: "
                       + ", ".join(i.strip() for i in ids))
            elif not re.match(r"^ca-pub-[0-9]{16}$", ids[0].strip()) or ids[0].strip() != pub:
                record("meta tag", "fail", f"meta tag has {ids[0].strip()!r}, want {pub} (copy-paste error?)")
            else:
                record("meta tag", "pass", f"exactly one tag in head, value {pub}")
            record("ad script", "info", "adsbygoogle.js present" if "adsbygoogle.js" in page
                   else "adsbygoogle.js not present in home page HTML")

    except DeadlineExceeded:
        record("run", "fail", "deadline exceeded")
    finally:
        if watchdog:
            signal.setitimer(signal.ITIMER_REAL, 0); signal.signal(signal.SIGALRM, prev)
    if args.json:
        print(json.dumps({"ok": ok, "publisher_id": pub, "domain": domain, "checks": checks, "fetches": results}, indent=2))
    else:
        print(f"adsense-check: {'ok' if ok else 'failed'}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
