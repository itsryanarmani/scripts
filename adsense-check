#!/usr/bin/env python3
"""adsense-check: verify the two AdSense ownership proofs on a site. See adsense-check.md."""
import argparse, json, os, re, sys, urllib.error, urllib.parse, urllib.request
from html.parser import HTMLParser

UA = "adsense-check/1.0 (+ownership check)"
TIMEOUT = 15
MAX_REDIRECTS = 3
MAX_BYTES = 2 * 1024 * 1024
CERT_ID = "f08c47fec0942fa0"
PUB_RE = re.compile(r"^(?:ca-pub-|pub-)(\d{16})$")
MULTI_TLD = {"ac.uk", "co.uk", "gov.uk", "com.au", "net.au", "org.au", "co.nz",
             "com.br", "com.mx", "co.jp", "co.in", "com.sg", "com.hk"}
REDIRECT_CODES = (301, 302, 303, 307, 308)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def registrable(host):
    """eTLD+1 approximation, enough for the www/apex rule."""
    host = (host or "").lower()
    if ":" in host:
        host = host.split(":")[0]
    if not host or re.fullmatch(r"[\d.]+", host):
        return host
    if host.startswith("www."):
        host = host[4:]
    labels = host.split(".")
    if len(labels) <= 2:
        return host
    if ".".join(labels[-2:]) in MULTI_TLD:
        return ".".join(labels[-3:])
    return ".".join(labels[-2:])


def fetch(url, site_reg):
    """GET url, follow at most MAX_REDIRECTS hops that stay on site_reg.
    Returns dict(status, headers, body, hops, error)."""
    hops = []
    for _ in range(MAX_REDIRECTS + 1):
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        try:
            with OPENER.open(req, timeout=TIMEOUT) as r:
                hops.append({"url": url, "status": r.status})
                return {"status": r.status, "headers": r.headers,
                        "body": r.read(MAX_BYTES + 1)[:MAX_BYTES], "hops": hops, "error": None}
        except urllib.error.HTTPError as e:
            hops.append({"url": url, "status": e.code})
            if e.code in REDIRECT_CODES:
                loc = e.headers.get("Location") if e.headers else None
                nxt = urllib.parse.urljoin(url, loc) if loc else None
                host = urllib.parse.urlparse(nxt).hostname if nxt else ""
                if not nxt or registrable(host) != site_reg:
                    return {"status": e.code, "headers": e.headers, "body": b"",
                            "hops": hops, "error": f"redirect left the site domain: {nxt}"}
                if len(hops) > MAX_REDIRECTS:
                    return {"status": e.code, "headers": e.headers, "body": b"",
                            "hops": hops, "error": "too many redirects"}
                url = nxt
                continue
            return {"status": e.code, "headers": e.headers, "body": b"",
                    "hops": hops, "error": None}
        except Exception as e:
            hops.append({"url": url, "status": type(e).__name__})
            return {"status": None, "headers": None, "body": b"",
                    "hops": hops, "error": f"{type(e).__name__}: {e}"}
    return {"status": None, "headers": None, "body": b"", "hops": hops,
            "error": "too many redirects"}


class MetaParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.tags = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() == "meta":
            self.tags.append(dict(attrs))

    handle_startendtag = handle_starttag


def meta_ids(html):
    p = MetaParser()
    try:
        p.feed(html)
    except Exception:
        pass
    return [t.get("content", "") for t in p.tags
            if t.get("name", "").lower() == "google-adsense-account"]


def normalize_pub(raw):
    m = PUB_RE.match((raw or "").strip())
    return "ca-pub-" + m.group(1) if m else None


def same_pub(value, pub):
    n = normalize_pub(value)
    return n is not None and n == pub


def ads_txt_problems(status, ctype, body, digits):
    problems = []
    if status != 200:
        problems.append(f"status {status}, want 200")
    if not (ctype or "").lower().startswith("text/plain"):
        problems.append(f"content-type {ctype or 'missing'}, want text/plain")
    text = body.decode("utf-8", "replace")
    if "<html" in text.lower():
        problems.append("body contains HTML (a soft 404 page returns 200)")
    want = f"google.com, pub-{digits}, DIRECT, {CERT_ID}"
    found = False
    for line in text.splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) == 4 and parts[0].lower() == "google.com" \
                and parts[1] == f"pub-{digits}" and parts[2].upper() == "DIRECT" \
                and parts[3] == CERT_ID:
            found = True
            break
    if not found:
        problems.append(f"no line '{want}'")
    return problems


def main():
    ap = argparse.ArgumentParser(
        description="Verify AdSense ownership proofs: ads.txt line and google-adsense-account meta tag.")
    ap.add_argument("domain", help="site domain, e.g. example.com")
    ap.add_argument("publisher_id", help="ca-pub-<16 digits> or pub-<16 digits>")
    ap.add_argument("--json", action="store_true", help="print one JSON object")
    args = ap.parse_args()

    pub = normalize_pub(args.publisher_id)
    if not pub:
        print(f"adsense-check: bad publisher id {args.publisher_id!r}; "
              "want ca-pub-<16 digits> or pub-<16 digits>", file=sys.stderr)
        return 2
    digits = pub[len("ca-pub-"):]

    domain = args.domain.strip().lower()
    for pre in ("https://", "http://"):
        if domain.startswith(pre):
            domain = domain[len(pre):]
    domain = domain.split("/")[0].split(":")[0]
    base = os.environ.get("ADSENSE_CHECK_BASE_URL", "").rstrip("/")
    site_host = urllib.parse.urlparse(base).hostname if base else domain
    site_reg = registrable(site_host)
    urls = {"ads.txt": f"{base}/ads.txt" if base else f"https://{domain}/ads.txt",
            "home": f"{base}/" if base else f"https://{domain}/"}

    checks, results, ok = [], {}, True

    def record(name, result, reason):
        nonlocal ok
        ok = ok and result != "fail"
        checks.append({"check": name, "result": result, "reason": reason})
        if not args.json:
            tag = {"fail": "FAIL", "pass": "PASS", "info": "INFO"}[result]
            print(f"{tag} {name}: {reason}" if reason else f"{tag} {name}")

    bodies = {}
    for key, url in urls.items():
        r = fetch(url, site_reg)
        bodies[key] = r
        results[key] = {"url": url, "status": r["status"], "hops": r["hops"],
                        **({"error": r["error"]} if r["error"] else {})}
        if not args.json:
            hops = " -> ".join(str(h["status"]) for h in r["hops"])
            print(f"INFO fetch {key}: {url} [{hops}]")

    # ads.txt: status, content type, publisher line, no HTML.
    at = bodies["ads.txt"]
    if at["error"]:
        record("ads.txt", "fail", at["error"])
    elif at["status"] != 200:
        record("ads.txt", "fail", f"status {at['status']}, want 200")
    else:
        ctype = at["headers"].get("Content-Type", "") if at["headers"] else ""
        probs = ads_txt_problems(at["status"], ctype, at["body"], digits)
        record("ads.txt", "fail" if probs else "pass",
               "; ".join(probs) if probs else f"status 200, text/plain, google.com DIRECT line for pub-{digits}")

    # meta tag on the home page: exactly one, value equals the publisher id.
    hm = bodies["home"]
    if hm["error"]:
        record("meta tag", "fail", hm["error"])
    elif hm["status"] != 200:
        record("meta tag", "fail", f"home page status {hm['status']}, want 200")
    else:
        html = hm["body"].decode("utf-8", "replace")
        ids = meta_ids(html)
        if len(ids) == 0:
            record("meta tag", "fail", "no google-adsense-account meta tag on the home page")
        elif len(ids) > 1:
            record("meta tag", "fail", f"{len(ids)} google-adsense-account meta tags, want exactly 1")
        elif not same_pub(ids[0], pub):
            record("meta tag", "fail",
                   f"meta tag has {ids[0]!r}, want {pub} (copy-paste error?)")
        else:
            record("meta tag", "pass", f"exactly one tag, value {pub}")
        has_script = "adsbygoogle.js" in html
        record("ad script", "info",
               "adsbygoogle.js present in home page HTML" if has_script
               else "adsbygoogle.js not present in home page HTML")

    if args.json:
        print(json.dumps({"ok": ok, "publisher_id": pub, "domain": domain,
                          "checks": checks, "fetches": results}, indent=2))
    else:
        print(f"adsense-check: {'ok' if ok else 'failed'}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
