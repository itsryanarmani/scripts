#!/usr/bin/env python3
"""Draw the 9:16 safe box on frames of a vertical video, so a person can look at them.

Usage: safe-frame-check VIDEO OUTDIR [--at 0,3,8,14,end]

Meta covers the top 14%, the bottom 35% and 6% on each side of a vertical ad with its
own interface. Anything a viewer must read, and the host's face, belongs inside the box:
x 65..1015, y 269..1248 on a 1080 x 1920 frame. The box is drawn in red, and the
unsafe area is dimmed. The tool cannot judge the text: look at each image.

Needs ffmpeg, ffprobe and Pillow. Exit codes: 0 done, 2 bad usage or a missing tool,
3 the video is not 1080 x 1920 (frames are still written, scaled to fit).
"""
import subprocess, sys, os, shutil

BOX = (65, 269, 1015, 1248)  # left, top, right, bottom on 1080 x 1920
W, H = 1080, 1920


def usage():
    print(__doc__.strip().split("\n\n")[0] + "\n\nusage: safe-frame-check VIDEO OUTDIR [--at 0,3,8,14,end]", file=sys.stderr)
    sys.exit(2)


args = [a for a in sys.argv[1:]]
if len(args) < 2:
    usage()
video, out = args[0], args[1]
at = "0,3,8,14,end"
if "--at" in args:
    i = args.index("--at")
    if i + 1 >= len(args):
        usage()
    at = args[i + 1]
if not os.path.isfile(video):
    print(f"no such file: {video}", file=sys.stderr)
    sys.exit(2)
for tool in ("ffmpeg", "ffprobe"):
    if not shutil.which(tool):
        print(f"{tool} is required", file=sys.stderr)
        sys.exit(2)
try:
    from PIL import Image, ImageDraw
except ImportError:
    print("Pillow is required: pip install pillow", file=sys.stderr)
    sys.exit(2)

probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "format=duration",
                        "-of", "csv=p=0", video], capture_output=True, text=True)
try:
    dur = float(probe.stdout.split()[0])
except Exception:
    print("could not read the video", file=sys.stderr)
    sys.exit(2)
shape = None  # the size of the frame as ffmpeg shows it, after any rotation metadata
os.makedirs(out, exist_ok=True)
stem = os.path.splitext(os.path.basename(video))[0]
written = []
for tok in at.split(","):
    tok = tok.strip()
    try:
        t = max(0.0, dur - 0.1) if tok == "end" else float(tok)
    except ValueError:
        print(f"bad time in --at: {tok!r} (use seconds or end)", file=sys.stderr)
        sys.exit(2)
    t = min(max(t, 0.0), max(0.0, dur - 0.05))
    raw = os.path.join(out, f"{stem}_{tok}.raw.png")
    if subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{t:.2f}", "-i", video, "-frames:v", "1", raw]).returncode != 0 or not os.path.exists(raw):
        print(f"ffmpeg could not read a frame at {tok}", file=sys.stderr)
        sys.exit(2)
    im = Image.open(raw).convert("RGB")
    shape = shape or im.size
    im = im.resize((W, H))
    shade = Image.new("RGBA", im.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(shade)
    d.rectangle((0, 0, W, H), fill=(0, 0, 0, 110))
    d.rectangle(BOX, fill=(0, 0, 0, 0))
    im = Image.alpha_composite(im.convert("RGBA"), shade).convert("RGB")
    ImageDraw.Draw(im).rectangle(BOX, outline=(255, 40, 40), width=4)
    dest = os.path.join(out, f"{stem}_{tok}.png")
    im.save(dest)
    os.remove(raw)
    written.append(dest)
print("\n".join(written))
if shape != (W, H):
    print(f"warning: the video shows {shape[0]}x{shape[1]}, not {W}x{H}; frames were scaled", file=sys.stderr)
    sys.exit(3)
