#!/usr/bin/env -S python3 -I
"""Keep an authenticator secret in a mode 600 env file and print the current code.

  totp save ENVFILE PREFIX   read an otpauth:// URI on stdin, store it
  totp code ENVFILE PREFIX   print the current code

The failure modes are in totp.failure-modes.md. The secret never reaches the
terminal. TOTP_NOW (seconds) sets the clock for the tests only.
"""
import base64
import binascii
import hashlib
import hmac
import os
import re
import struct
import sys
import time
import urllib.parse

ALGOS = {"SHA1": hashlib.sha1, "SHA256": hashlib.sha256, "SHA512": hashlib.sha512}
PREFIX_RE = re.compile(r"[A-Z0-9_]+")


def die(code, message):
    print(f"totp: {message}", file=sys.stderr)
    sys.exit(code)


def decode_secret(secret):
    cleaned = secret.replace(" ", "").replace("=", "").upper()
    if not cleaned:
        die(2, "the secret is empty")
    try:
        return base64.b32decode(cleaned + "=" * (-len(cleaned) % 8))
    except (binascii.Error, ValueError):
        die(2, "the secret is not valid base32")


def check_settings(algo, digits, period):
    if algo not in ALGOS:
        die(2, f"algorithm {algo!r} is not SHA1, SHA256 or SHA512")
    if not (digits.isdigit() and 6 <= int(digits) <= 8):
        die(2, "digits must be 6 to 8")
    if not (period.isdigit() and int(period) > 0):
        die(2, "period must be a positive number of seconds")


def check_prefix(prefix):
    if not PREFIX_RE.fullmatch(prefix):
        die(2, "PREFIX may hold only capital letters, digits and underscores")


def read_env(path):
    values = {}
    with open(path) as handle:
        for line in handle:
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.rstrip("\n").split("=", 1)
                values[key] = value
    return values


def save(path, prefix):
    check_prefix(prefix)
    uri = urllib.parse.urlparse(sys.stdin.read().strip())
    if uri.scheme != "otpauth" or uri.netloc != "totp":
        die(2, "stdin is not an otpauth://totp/ URI")
    query = urllib.parse.parse_qs(uri.query)
    if not query.get("secret"):
        die(2, "the URI has no secret")
    secret = query["secret"][0]
    algo = query.get("algorithm", ["SHA1"])[0].upper()
    digits = query.get("digits", ["6"])[0]
    period = query.get("period", ["30"])[0]
    decode_secret(secret)
    check_settings(algo, digits, period)

    own = re.compile(rf"{prefix}_TOTP_(SECRET|ALGO|DIGITS|PERIOD)=")
    kept = []
    if os.path.exists(path):
        with open(path) as handle:
            kept = [line for line in handle.read().splitlines() if not own.match(line)]
    kept += [
        f"{prefix}_TOTP_SECRET={secret}",
        f"{prefix}_TOTP_ALGO={algo}",
        f"{prefix}_TOTP_DIGITS={digits}",
        f"{prefix}_TOTP_PERIOD={period}",
    ]
    tmp = f"{path}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write("\n".join(kept) + "\n")
    os.replace(tmp, path)
    os.chmod(path, 0o600)
    print(f"saved {prefix}: {digits} digits, {period}s, {algo}")


def code(path, prefix):
    check_prefix(prefix)
    if not os.path.exists(path):
        die(4, f"{path} does not exist")
    if os.stat(path).st_mode & 0o077:
        die(3, f"{path} can be read by group or others; run chmod 600")
    env = read_env(path)
    key = f"{prefix}_TOTP_SECRET"
    if key not in env:
        die(4, f"{path} has no {key}")
    algo = env.get(f"{prefix}_TOTP_ALGO", "SHA1").upper()
    digits = env.get(f"{prefix}_TOTP_DIGITS", "6")
    period = env.get(f"{prefix}_TOTP_PERIOD", "30")
    check_settings(algo, digits, period)
    key_bytes = decode_secret(env[key])
    now = int(os.environ.get("TOTP_NOW") or time.time())
    digest = hmac.new(key_bytes, struct.pack(">Q", now // int(period)), ALGOS[algo]).digest()
    offset = digest[-1] & 15
    number = (struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF) % 10 ** int(digits)
    print(str(number).zfill(int(digits)))


def main():
    if len(sys.argv) != 4 or sys.argv[1] not in ("save", "code"):
        die(1, "usage: totp save|code ENVFILE PREFIX")
    {"save": save, "code": code}[sys.argv[1]](sys.argv[2], sys.argv[3])


main()
