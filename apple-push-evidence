#!/usr/bin/env python3
"""Refresh an owned local clone and run unsigned Apple evidence. Plan by default."""
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('config',type=Path)
    parser.add_argument('--execute',action='store_true')
    args=parser.parse_args()
    config=json.loads(args.config.read_text())
    if set(config)!={'repository','branch','projectSpec','evidenceConfig','output'}:
        raise ValueError('Invalid fields')
    if any(not isinstance(v,str) or not v for v in config.values()):
        raise ValueError('Invalid values')
    repo=Path(config['repository']).resolve(strict=True)
    output=Path(config['output']).resolve()
    if repo==output or repo in output.parents:
        raise ValueError('Output must be external')
    branch=config['branch']
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._/-]*',branch) or '..' in branch:
        raise ValueError('Invalid branch')
    spec=Path(config['projectSpec'])
    if spec.is_absolute() or '..' in spec.parts or spec.suffix not in {'.yml','.yaml','.json'}:
        raise ValueError('Invalid project spec')
    evidence_config=Path(config['evidenceConfig']).resolve(strict=True)
    if repo in evidence_config.parents or evidence_config==repo:
        raise ValueError('Evidence config must be external')
    evidence=json.loads(evidence_config.read_text())
    if Path(evidence['repository']).resolve()!=repo:
        raise ValueError('Different repository')
    def git(*argv):
        return subprocess.check_output(['git','-C',str(repo),*argv],text=True,stderr=subprocess.DEVNULL).strip()
    if Path(git('rev-parse','--show-toplevel')).resolve()!=repo:
        raise ValueError('Checkout root required')
    git_dir=Path(git('rev-parse','--absolute-git-dir')).resolve()
    if git_dir!=repo/'.git' or not (repo/'.git').is_dir() or (repo/'.git').is_symlink():
        raise ValueError('Dedicated clone required')
    marker=git_dir/'apple-push-evidence-owned'
    if marker.is_symlink() or marker.read_text()!='apple-push-evidence\n':
        raise ValueError('Ownership marker required')
    if git('status','--porcelain'):
        raise ValueError('Clean checkout required')
    git('check-ref-format','--branch',branch)
    summary={'status':'planned','branch':branch,'sourceCommit':git('rev-parse','HEAD'),'uploadExecuted':False}
    if not args.execute:
        print(json.dumps(summary))
        return 0
    output.mkdir(parents=True,exist_ok=True,mode=0o700)
    if output.stat().st_mode & 0o077:
        raise ValueError('Private output required')
    lock_path=output/'.lock'
    if lock_path.is_symlink():
        raise ValueError('Invalid lock')
    with lock_path.open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        run=output/(datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+uuid.uuid4().hex[:8])
        run.mkdir(mode=0o700)
        summary['artifactDirectory']=str(run)
        summary['status']='failed'
        started=time.monotonic()
        def execute(name,argv,cwd=repo):
            with (run/(name+'.log')).open('w') as log:
                result=subprocess.run(argv,cwd=cwd,stdout=log,stderr=subprocess.STDOUT)
            if result.returncode:
                raise ValueError('Phase failed')
        try:
            # No forced fetch, reset, clean, or branch mutation.
            execute('fetch',['git','fetch','--no-tags','origin',f'refs/heads/{branch}:refs/remotes/origin/{branch}'])
            commit=git('rev-parse','--verify',f'refs/remotes/origin/{branch}^{{commit}}')
            execute('checkout',['git','checkout','--detach',commit])
            summary['sourceCommit']=commit
            project_spec=(repo/spec).resolve(strict=True)
            if repo not in project_spec.parents:
                raise ValueError('Spec escapes checkout')
            execute('generate',['xcodegen','generate','--spec',str(project_spec)])
            if git('status','--porcelain') or git('rev-parse','HEAD')!=commit:
                raise ValueError('Generator changed tracked source')
            runner=Path(__file__).resolve().with_name('apple-build-evidence')
            execute('evidence',[str(runner),str(evidence_config),'--output',str(output/'evidence'),'--execute'])
            result=json.loads((run/'evidence.log').read_text())
            if result.get('status') not in {'passed','unchanged'} or result.get('uploadExecuted') is not False:
                raise ValueError('Evidence did not pass')
            if git('status','--porcelain') or git('rev-parse','HEAD')!=commit:
                raise ValueError('Source changed during build')
            summary.update(status=result['status'],evidence=result)
        except (OSError,ValueError,subprocess.CalledProcessError):
            summary['failure']='A local phase failed. Inspect private logs.'
        finally:
            summary['durationSeconds']=round(time.monotonic()-started,3)
            (run/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
        print(json.dumps(summary))
        return 0 if summary['status'] in {'passed','unchanged'} else 1


if __name__=='__main__':
    os.umask(0o077)
    try:
        sys.exit(main())
    except (OSError,ValueError,KeyError,TypeError,subprocess.CalledProcessError):
        print('Local Apple push check rejected. Check config, ownership, clean source and exclusive access.',file=sys.stderr)
        sys.exit(1)
