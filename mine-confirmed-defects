# Responses are cached on disk because a full fleet mine costs roughly two API
# calls per merged pull request, which is more than an hour's rate limit. Without
# a cache a throttle three repos in loses every call already paid for, and the
# re-run starts from zero. Keyed on the exact argument list, so a changed query is
# a different entry.
CACHE_DIR = os.environ.get("MINE_CACHE_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "mine-confirmed-defects",
)


def ensure_cache_dir():
    """Create the cache privately and reject an untrusted existing directory."""
    try:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        info = os.lstat(CACHE_DIR)
    except OSError as e:
        die(f"error: cannot prepare cache directory {CACHE_DIR}: {e}")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        die(f"error: cache directory {CACHE_DIR} must be a directory owned by the current user")
    try:
        os.chmod(CACHE_DIR, 0o700)
    except OSError as e:
        die(f"error: cannot secure cache directory {CACHE_DIR}: {e}")


class RateLimited(Exception):
    """gh refused the call because the API rate limit is exhausted."""


