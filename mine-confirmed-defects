def gh_json(args, ttl=None):
    ensure_cache_dir()
    # GH_HOST changes what a given `args` list actually fetches, so it must be
    # part of the key or two hosts would share one entry.
    key_material = "\x00".join(args) + "\x00" + os.environ.get("GH_HOST", "")
    key = hashlib.sha256(key_material.encode()).hexdigest()[:32]
    path = os.path.join(CACHE_DIR, key + ".json")
    if os.path.exists(path) and (ttl is None or time.time() - os.path.getmtime(path) < ttl):
        try:
            with open(path, encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            os.unlink(path)
    try:
        out = subprocess.check_output(
            ["gh", "api"] + args, text=True, stderr=subprocess.PIPE
        )
    except subprocess.CalledProcessError as e:
        # A throttle is not a failure of this run, it is a pause. Raise so the
        # caller can emit everything gathered so far instead of dying with
        # nothing, which is what loses an hour of paid-for calls.
        if "rate limit" in (e.stderr or "").lower():
            raise RateLimited(" ".join(args[:2]))
        die(f"error: gh api {' '.join(args[:3])} failed (exit {e.returncode}): {(e.stderr or '').strip()}")
    try:
        parsed = json.loads(out)
    except json.JSONDecodeError as e:
        die(f"error: invalid JSON: {e}")
    fd, tmp = tempfile.mkstemp(dir=CACHE_DIR, prefix=f".{key}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fd = -1
            json.dump(parsed, fh)
        os.replace(tmp, path)
    finally:
        if fd != -1:
            os.close(fd)
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    return parsed
def as_list(payload):
    if isinstance(payload, list):
        out = []
        for page in payload:
            if isinstance(page, list):
                out.extend(page)
            elif isinstance(page, dict):
                out.append(page)
        return out
    return [payload] if isinstance(payload, dict) else []
