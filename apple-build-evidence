#!/usr/bin/env python3
"""Plan or run local Xcode tests and an unsigned archive. Never upload."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid


def write_json(path, value):
    staged = path.with_suffix('.tmp')
    staged.write_text(json.dumps(value, indent=2)+'\n')
    staged.replace(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('config', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--execute', action='store_true')
    args = parser.parse_args()
    config = json.loads(args.config.read_text())
    allowed = {'repository', 'project', 'scheme', 'inputs', 'destinations'}
    if not allowed <= set(config) or set(config) - allowed - {'buildSettings'}:
        raise ValueError('Invalid config fields')
    build_settings = config.get('buildSettings', {})
    patterns = {'CURRENT_PROJECT_VERSION': r'[1-9][0-9]{0,8}',
                'MARKETING_VERSION': r'[0-9]{1,4}(?:\.[0-9]{1,2}){0,2}'}
    if not isinstance(build_settings, dict) or any(
        key not in patterns or not isinstance(value, str) or not re.fullmatch(patterns[key], value)
        for key, value in build_settings.items()
    ):
        raise ValueError('Invalid build identity settings')
    identity_args = [f'{key}={value}' for key, value in sorted(build_settings.items())]
    repo = Path(config['repository']).resolve(strict=True)
    output = args.output.resolve()
    if output == repo or repo in output.parents:
        raise ValueError('Evidence output must be outside the source repository')
    def git(*argv):
        return subprocess.check_output(['git', '-C', str(repo), *argv], text=True, stderr=subprocess.DEVNULL).strip()
    if Path(git('rev-parse', '--show-toplevel')).resolve() != repo:
        raise ValueError('repository must be the Git checkout root')
    def source_path(value):
        if not isinstance(value, str) or not value or Path(value).is_absolute():
            raise ValueError('Source paths must be relative')
        p = (repo / value).resolve(strict=True)
        if repo not in p.parents:
            raise ValueError('Source path escapes repository')
        return p
    project = source_path(config['project'])
    if project.suffix != '.xcodeproj':
        raise ValueError('project must name an existing .xcodeproj')
    scheme = config['scheme']
    destinations = config['destinations']
    if not isinstance(scheme, str) or not scheme or scheme.startswith('-'):
        raise ValueError('Invalid scheme')
    if not isinstance(destinations, list) or not destinations or any(not isinstance(d, str) or not d.startswith('platform=iOS Simulator,') for d in destinations):
        raise ValueError('At least one explicit iOS Simulator destination is required')
    if not isinstance(config['inputs'], list) or not config['inputs']:
        raise ValueError('inputs must list source files or directories')
    def fingerprint():
        if git('status', '--porcelain'):
            raise ValueError('Source checkout must be clean')
        digest = hashlib.sha256(json.dumps(config, sort_keys=True).encode())
        files = set()
        for item in config['inputs']:
            p = source_path(item)
            for candidate in (p.rglob('*') if p.is_dir() else [p]):
                if candidate.is_symlink():
                    raise ValueError('Symlinked inputs are unsupported')
                if candidate.is_file():
                    files.add(candidate)
        if not files:
            raise ValueError('Source inputs contain no files')
        for p in sorted(files):
            digest.update(str(p.relative_to(repo)).encode()+b'\0'+p.read_bytes()+b'\0')
        # Include the actual generated project consumed by xcodebuild.
        for p in sorted(project.rglob('*')):
            if p.is_symlink():
                raise ValueError('Symlinked project files are unsupported')
            if p.is_file() and 'xcuserdata' not in p.parts:
                digest.update(str(p.relative_to(repo)).encode()+b'\0'+p.read_bytes()+b'\0')
        return digest.hexdigest()
    head = git('rev-parse', 'HEAD')
    source_hash = fingerprint()
    summary = {'schemaVersion': 1, 'status': 'planned', 'sourceCommit': head, 'sourceHash': source_hash, 'phases': [], 'destinations': destinations, 'buildSettings': build_settings, 'archiveSigning': 'disabled', 'uploadExecuted': False}
    if not args.execute:
        print(json.dumps(summary))
        return 0
    output.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (output / '.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('Another evidence run holds the output lock') from None
        stamp = output / 'success.json'
        if stamp.exists():
            previous = json.loads(stamp.read_text())
            prior_dir = Path(previous.get('artifactDirectory', '/')).resolve()
            retained = output in prior_dir.parents and (prior_dir/'app.xcarchive').is_dir()
            retained = retained and all((prior_dir/f'test-{i}.xcresult').is_dir() for i in range(len(destinations)))
            if previous.get('sourceHash') == source_hash and retained:
                previous.update(status='unchanged', requestedSourceCommit=head)
                print(json.dumps(previous))
                return 0
        run = output / (time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())+'-'+uuid.uuid4().hex[:8])
        run.mkdir(mode=0o700)
        summary['artifactDirectory'] = str(run)
        base = ['xcodebuild', '-project', str(project), '-scheme', scheme, *identity_args]
        phases = [(f'test-{i}', base+['test', '-destination', dest, '-resultBundlePath', str(run/f'test-{i}.xcresult'), 'CODE_SIGNING_ALLOWED=NO']) for i, dest in enumerate(destinations)]
        phases.append(('archive', base+['archive', '-destination', 'generic/platform=iOS', '-archivePath', str(run/'app.xcarchive'), 'CODE_SIGNING_ALLOWED=NO']))
        summary['status'] = 'failed'
        started = time.monotonic()
        try:
            for name, argv in phases:
                phase_start = time.monotonic()
                with (run/f'{name}.log').open('w') as log:
                    code = subprocess.run(argv, cwd=repo, stdout=log, stderr=subprocess.STDOUT).returncode
                summary['phases'].append({'name': name, 'exitCode': code, 'durationSeconds': round(time.monotonic()-phase_start, 3), 'log': f'{name}.log'})
                if code:
                    break
            else:
                if git('rev-parse', 'HEAD') != head or fingerprint() != source_hash:
                    raise ValueError('Source changed during execution')
                if not (run/'app.xcarchive').is_dir() or any(not (run/f'test-{i}.xcresult').is_dir() for i in range(len(destinations))):
                    raise ValueError('Expected Xcode artifacts are missing')
                summary['status'] = 'passed'
        except (OSError, ValueError, KeyboardInterrupt):
            summary['failure'] = 'Execution interrupted, source changed, or a required artifact is missing; inspect private logs'
        finally:
            summary['durationSeconds'] = round(time.monotonic()-started, 3)
            write_json(run/'summary.json', summary)
        if summary['status'] == 'passed':
            write_json(stamp, summary)
        print(json.dumps(summary))
        return 0 if summary['status'] == 'passed' else 1


if __name__ == '__main__':
    os.umask(0o077)
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        # Input and tool errors can contain private paths. Never echo raw exceptions.
        print('Apple evidence run rejected. Check config paths, clean source, tools and exclusive output access.', file=sys.stderr)
        sys.exit(1)
