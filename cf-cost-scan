#!/usr/bin/env python3
"""Scan local repos for patterns that raise the Cloudflare bill. Read-only.

Prints `repo | check | status | file:line | why it costs`.
Status is found (a fact in the code), review (a guess to check), clear or n-a.
Exit 0 always, unless `--fail-on found` is set and a check is found (exit 1). Bad usage exits 2.
"""
import argparse
import math
import os
import re
import sys

SKIP = {'node_modules', '.git', '.next', '.open-next', '.vercel', '.turbo', '.svelte-kit', '.wrangler', 'coverage', 'dist', 'build', 'out'}
CODE = ('.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs', '.mts', '.cts')
WRANGLER = ('wrangler.jsonc', 'wrangler.json', 'wrangler.toml')
CACHE_HINT = re.compile(r'revalidate|unstable_cache|cache-control|s-maxage|force-static|caches\.default', re.I)
DATA_CACHE = re.compile(r'unstable_cache|cachedIf\(|\bcached\(|revalidate\s*=\s*[1-9]\d*|revalidate\s*:')
D1_USE = re.compile(r'\.prepare\(|\benv\.DB\b|getCloudflareContext')

# name -> (needs, why it costs)
CHECKS = {
    'link-prefetch': ('next', 'Each visible Link prefetches its route, so one page view fans out into many Worker requests.'),
    'rsc-guard': ('next', 'Bots and prefetch send _rsc requests with no RSC header; each one runs the Worker and its D1 reads.'),
    'json-cache-key': ('next', 'A key built from JSON.stringify of free-form params makes a new entry per variant, so the cache never hits.'),
    'short-revalidate': ('next', 'A short window re-runs the D1 query often for data that changes only by import.'),
    'sitemap-d1-uncached': ('next', 'A sitemap with no cache queries D1 on every crawler hit, and crawlers hit it all day.'),
    'invocation-logs': ('wrangler', 'Routine per-request invocation logs bill one log event for every request.'),
    'cron-every-minute': ('wrangler', 'A cron every minute is 1,440 Worker runs a day, plus whatever each run reads or writes.'),
    'static-txt-route': ('next', 'A route that serves robots.txt, llms.txt, ai.txt or security.txt runs the Worker; a static file does not.'),
    'cache-key-unbounded': ('next', 'A data-cache key built from a request value makes one billed KV write per distinct value. Add a `cache-key: bounded` comment when the set is small.'),
    'd1-n-plus-one': ('d1', 'A D1 query awaited in a loop runs once per item; each run reads rows and adds latency. Batch or join instead.'),
    'select-unbounded': ('d1', 'SELECT * or a select with no WHERE and no LIMIT in a route handler can read a whole table on every request.'),
    'json-each-materialized': ('d1', 'json_each with MATERIALIZED or a recursive CTE is a query shape to check; one such query family read 173M rows in 16 hours (MEASURED).'),
    'count-star-uncached': ('d1', 'COUNT(*) in a route with no cache scans the table on every request. Store the count at import.'),
    'request-path-logs': ('wrangler', 'console.log or console.info in the request path may bill a log event on every request when Workers observability is on. Only invocation logs were measured in this work, not console logs.'),
    'minify-true': ('wrangler', 'minify: true may raise cold-start CPU. One fleet test saw no change in CPU per request at scale, so the effect is unconfirmed.'),
}

def walk(root):
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP]
        for f in files:
            yield os.path.join(base, f)

NOT_PREFETCH_OFF = lambda rel, t, m: 'prefetch={false}' not in m.group(0)
SHORT = lambda rel, t, m: 0 < math.prod(map(int, re.findall(r'\d+', m.group(1)))) < 3600
SITEMAP = lambda rel, t, m: 'sitemap' in rel and D1_USE.search(t) and not CACHE_HINT.search(t)
TXT = lambda rel, t, m: re.search(r'(^|/)(robots|llms|ai|security)\.txt/route\.[tj]sx?$', rel)
ROUTE = re.compile(r'(^|/)(route|page)\.[tj]sx?$|(^|/)api/')
ENTRY = re.compile(r'(^|/)(middleware|worker|index)\.[tj]sx?$')
NOT_APP = re.compile(r'(^|/)(tests?|__tests__|scripts|bin|migrations?)/|\.(test|spec)\.')

def in_catch(t, pos):
    """Walk back out of the enclosing blocks; True when one is a catch block. Braces in strings fool it."""
    depth = 0
    for i in range(pos - 1, -1, -1):
        if t[i] == '}':
            depth += 1
        elif t[i] == '{':
            if depth:
                depth -= 1
            elif re.search(r'\bcatch\s*(\([^)]*\))?\s*$', t[max(0, i - 80):i]):
                return True
    return False

def unbounded(rel, t, m):
    line = t.count('\n', 0, m.start())
    near = '\n'.join(t.split('\n')[max(0, line - 3):line + 1])
    return 'cache-key: bounded' not in near and not re.match(r'cachedIf\(\s*head\s*,', m.group(0))

def full_select(rel, t, m):
    stmt = t[m.start():m.end() + re.search(r'["\'`;]|$', t[m.end():]).start()]
    return not NOT_APP.search(rel) and not DATA_CACHE.search(t) and not re.search(
        r'\bLIMIT\b|\bWHERE\s+(?:id|slug|key)\s*=', stmt, re.I)
USES_D1 = lambda rel, t, m: D1_USE.search(t)
UNCACHED_COUNT = lambda rel, t, m: not NOT_APP.search(rel) and not DATA_CACHE.search(t)
REQUEST_LOG = lambda rel, t, m: ((ROUTE.search(rel) or ENTRY.search(rel)) and not NOT_APP.search(rel) and not in_catch(t, m.start())
                                 and not re.search(r'NODE_ENV\s*!==?\s*["\']production', t[max(0, m.start() - 150):m.start()]))
LOOP_QUERY = (r'(?:\b(?:for|while)\s*\([^)]*\)\s*\{[^{}]*\bawait\b[^{}]*'
              r'|\.map\(\s*async\b[^;]{0,200}?)\.(?:prepare|first|all)\(')
# name -> (file set, regex, flags, status on a hit, filter). A guess from text is `review`, never `found`.
RULES = {
    'link-prefetch': ('code', r'<Link\b(?:=>|[^>])*>', 0, 'review', NOT_PREFETCH_OFF),
    'json-cache-key': ('code', r'\b(unstable_cache|cached)\([\s\S]{0,300}?JSON\.stringify', 0, 'review', None),
    'short-revalidate': ('code', r'revalidate\s*[:=]\s*((?:\d+\s*\*\s*)*\d+)', 0, 'review', SHORT),
    'sitemap-d1-uncached': ('code', '^', 0, 'review', SITEMAP),
    'invocation-logs': ('wr', r'invocation_logs["\']?\s*[:=]\s*true', 0, 'found', None),
    'cron-every-minute': ('wr', r'["\']\s*(\*|\*/1)(\s+\*){4}\s*["\']', 0, 'review', None),
    'static-txt-route': ('code', '^', 0, 'found', TXT),
    'cache-key-unbounded': ('code', r'\b(?:unstable_cache|cachedIf|cached)\([^;]{0,300}?\[[^\]]*(?:\b(?:slug|city|query|q|userId)\b|(?<![.\w])id\b|\b(?:params|req|request|searchParams)\.id\b)[^\]]*\]', 0, 'review', unbounded),
    'd1-n-plus-one': ('code', LOOP_QUERY, 0, 'review', USES_D1),
    'select-unbounded': ('code', r'SELECT\s+\*|SELECT\s[^"\'`;]*?\bFROM\s+\w+\s*(?=["\'`])', 0, 'review', full_select),
    'json-each-materialized': ('code', r'MATERIALIZED[\s\S]{0,600}?json_each\(|WITH\s+RECURSIVE[^;"\'`]{0,600}?json_each\(|json_each\([\s\S]{0,600}?MATERIALIZED', re.I, 'review', None),
    'count-star-uncached': ('code', r'COUNT\(\s*\*\s*\)', re.I, 'review', UNCACHED_COUNT),
    'request-path-logs': ('code', r'console\.(?:log|info)\(', 0, 'review', REQUEST_LOG),
    'minify-true': ('wr', r'["\']?minify["\']?\s*[:=]\s*true', 0, 'review', None),
}

def first(files, regex, flags, pick):
    """Return 'rel:line' of the first match that passes pick, or None."""
    for rel, text in files:
        for m in re.finditer(regex, text, flags):
            if pick is None or pick(rel, text, m):
                return f'{rel}:{text.count(chr(10), 0, m.start()) + 1}'
    return None

def scan(path):
    root = os.path.abspath(path)
    files, pkg = {'code': [], 'wr': []}, ''
    for full in walk(root):
        rel, name = os.path.relpath(full, root), os.path.basename(full)
        if name not in WRANGLER and not name.endswith(CODE) and name != 'package.json':
            continue
        try:
            if os.path.getsize(full) > 1_000_000:
                continue
            text = open(full, encoding='utf-8', errors='replace').read()
        except OSError:
            continue
        if name == 'package.json':
            pkg += text
        else:
            files['wr' if name in WRANGLER else 'code'].append((rel, text))
    has = {'next': bool(re.search(r'"next"\s*:', pkg)), 'wrangler': bool(files['wr']),
           'd1': any(D1_USE.search(t) for _, t in files['code'])}
    out = {}
    for name, (kind, regex, flags, status, pick) in RULES.items():
        loc = first(files[kind], regex, flags, pick)
        out[name] = (status, loc) if loc else ('clear', '-')
    out['rsc-guard'] = ('clear', '-') if first(files['code'], '_rsc', 0, None) else ('review', '-')
    return [(n, *(out[n] if has[CHECKS[n][0]] else ('n-a', '-')), CHECKS[n][1]) for n in CHECKS]

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('paths', nargs='*', default=['.'], help='repo directories (default: current directory)')
    ap.add_argument('--fail-on', choices=['found'], help='exit 1 when any check has this status')
    args = ap.parse_args()
    for p in args.paths:
        if not os.path.isdir(p):
            ap.error(f'not a directory: {p}')
    print('repo | check | status | file:line | why it costs')
    hit = False
    for p in args.paths:
        repo = os.path.basename(os.path.abspath(p))
        for name, status, where, why in scan(p):
            hit = hit or status == 'found'
            print(f'{repo} | {name} | {status} | {where} | {why}')
    return 1 if args.fail_on and hit else 0

if __name__ == '__main__':
    sys.exit(main())
